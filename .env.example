# GEMINI_API_KEY: Wajib untuk fitur Narasi Suara AI Gemini (/api/tts/*).
# Dipakai hanya di sisi server (server.ts lokal dan Netlify Function netlify/functions/tts.mts).
# Untuk deploy Netlify via GitHub Sync: isi GEMINI_API_KEY di Site configuration -> Environment variables.
# JANGAN gunakan awalan VITE_ agar API key tidak pernah terbawa ke bundle browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat aplikasi di-hosting (opsional, diisi otomatis oleh runtime).
APP_URL="MY_APP_URL"
